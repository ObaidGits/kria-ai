    { "id": "g01", "category": "generality", "prompt": "Open Foobar123", "expect": "honest_not_installed", "sub_goals": [ { "kind": "open_app", "target_hint": "foobar123" } ], "notes": "NEGATIVE: nonexistent app -> must reply not installed (+suggestions), never open a wrong app. PASS = honest refusal verified, not a forced action." },
