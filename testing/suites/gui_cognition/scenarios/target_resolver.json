{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "step5.resolve.search_button",
      "title": "Step 5 resolves a unique Search button and stops before execution",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "step5_target_resolver", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "text_field_and_button",
          "action_backend_fixture": "global_halt"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Click the Search button",
        "expected_status_any": ["ok"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["ObservationCompleted", "ContextBuilt", "GoalContractCreated", "PlanCreated", "PlanValidationCompleted", "TargetResolutionStarted", "TargetResolutionCompleted", "TurnCompleted"],
        "forbidden_gui_event_types": ["ActionStarted", "ActionCompleted", "ExecutionStarted"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.target_resolution.status", "equals": "resolved" },
          { "path": "gui_cognition.target_resolution.can_execute", "equals": false },
          { "path": "gui_cognition.target_resolution.can_proceed_to_safety_gate", "equals": true },
          { "path": "gui_cognition.target_resolution.resolved_target.label", "equals": "Search" },
          { "path": "gui_cognition.target_resolution.resolved_target.role", "equals": "push button" },
          { "path": "gui_cognition.target_resolution.resolved_target.control_id", "exists": true },
          { "path": "gui_cognition.target_resolution.resolved_target.bounds.x", "exists": true },
          { "path": "gui_cognition.target_resolution.resolved_target.target_hash", "exists": true }
        ]
      }
    },
