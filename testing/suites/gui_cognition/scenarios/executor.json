{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "step7.execute.focus_search_box_fixture",
      "title": "Step 7 executes a low-risk FocusField proposal through the fixture executor",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "step7_executor", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "focused_search_field",
          "action_backend_fixture": "services_healthy",
          "execution_mode": "execute_fixture"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Focus the search box",
        "expected_status_any": ["completed"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["ObservationCompleted", "ContextBuilt", "GoalContractCreated", "PlanCreated", "PlanValidationCompleted", "TargetResolutionCompleted", "SafetyGateCompleted", "ActionStarted", "ActionCompleted", "ExecutionVerificationCompleted", "TurnCompleted"],
        "forbidden_gui_event_types": ["ActionFailed", "ExecutionBlocked"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.safety_gate.safety_status", "equals": "safe_no_approval_required" },
          { "path": "gui_cognition.execution.status", "equals": "completed" },
          { "path": "gui_cognition.execution.backend_used", "equals": "fixture_executor" },
          { "path": "gui_cognition.execution.proposal_hash", "exists": true },
          { "path": "gui_cognition.target_resolution.resolved_target.target_hash", "exists": true }
        ],
        "forbidden_json_paths": [
          "gui_cognition.raw_prompt",
          "gui_cognition.perception.ocr_blocks.0.text",
          "gui_cognition.perception.screenshot"
        ]
      }
    },
    {
