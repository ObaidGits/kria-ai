{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "step10.workflow.open_focus_completes",
      "title": "Step 10 runs an OpenApp + FocusField workflow one verified step at a time",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "step10_workflow_runtime", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "focused_search_field",
          "action_backend_fixture": "services_healthy",
          "execution_mode": "execute_fixture",
          "workflow": true
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Open KRIA Perception Test and focus the visible search field",
        "expected_status_any": ["completed"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["GoalContractCreated", "PlanCreated", "PlanValidationCompleted", "WorkflowRunStarted", "WorkflowStepStarted", "ActionStarted", "ActionCompleted", "ExecutionVerificationCompleted", "WorkflowStepCompleted", "WorkflowRunCompleted", "TurnCompleted"],
        "forbidden_gui_event_types": ["WorkflowRunBlocked", "ExecutionBlocked", "ActionFailed"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.workflow_run.status", "equals": "completed" },
          { "path": "gui_cognition.workflow_run.step_count", "exists": true },
          { "path": "gui_cognition.workflow_run.completed_step_receipts.0.receipt_id", "exists": true }
        ],
        "forbidden_json_paths": [
          "gui_cognition.raw_prompt",
          "gui_cognition.perception.ocr_blocks.0.text",
          "gui_cognition.perception.screenshot"
        ]
      }
    },
    {
      "id": "step10.workflow.verify_each_step_before_next",
      "title": "Step 10 verifies each step (ExecutionVerificationCompleted) before completing the workflow",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "step10_workflow_runtime", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "focused_search_field",
          "action_backend_fixture": "services_healthy",
          "execution_mode": "execute_fixture",
          "workflow": true
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Open KRIA Perception Test and focus the visible search field",
        "expected_status_any": ["completed"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["WorkflowStepStarted", "ExecutionVerificationCompleted", "WorkflowStepCompleted", "WorkflowRunCompleted"],
        "forbidden_gui_event_types": ["ActionFailed", "WorkflowRunBlocked"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "gui_cognition.workflow_run.status", "equals": "completed" },
          { "path": "gui_cognition.verification.status", "equals": "verified" }
        ],
        "forbidden_json_paths": [
          "gui_cognition.raw_prompt",
          "gui_cognition.perception.screenshot"
        ]
      }
    },
