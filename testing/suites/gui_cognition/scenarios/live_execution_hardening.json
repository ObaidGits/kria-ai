{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "gui_cognition.backend.global_halt_blocks_action",
      "title": "GUI Cognition global safety halt blocks action before execution",
      "driver": "desktop_chat_command",
      "tags": [
        "live",
        "slow",
        "gui_cognition",
        "desktop_command",
        "action_backend",
        "execution",
        "regression"
      ],
      "required_services": ["kria_api"],
      "timeout_seconds": 60,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Focus the visible search/input field on the current screen and verify it is focused.",
        "expected_status_any": ["ok"],
        "expected_reply_contains_any": ["Target resolution completed for Step 5", "did not execute"],
        "expected_reply_not_contains_any": ["LLM error", "tool-calling"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": [
          "ActionBackendStatus",
          "TargetResolutionCompleted",
          "TurnCompleted"
        ],
        "forbidden_gui_event_types": ["ExecutionBlocked", "VerificationCompleted", "ActionStarted", "ActionCompleted"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.llm_tool_loop", "equals": false },
          { "path": "gui_cognition.action_backend.global_halt_engaged", "equals": true },
          { "path": "gui_cognition.action_backend.can_execute_actions", "equals": false },
          { "path": "gui_cognition.action_backend.selected_backend", "equals": "blocked_global_halt" },
          { "path": "gui_cognition.target_resolution.status", "equals": "resolved" },
          { "path": "gui_cognition.target_resolution.can_execute", "equals": false }
        ],
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "text_field_and_button",
          "action_backend_fixture": "global_halt"
        }
      }
    },
