{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "gui_cognition.perception_completion.fixture_full_contract",
      "title": "Combined remaining perception hardening contract is present",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "perception_completion", "perception", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 90,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "What is on my screen? Report active window, focus, controls, visual buttons, accessibility health, OCR, monitor, and timing.",
        "expected_status_any": ["ok"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["TurnStarted", "RouteConfirmed", "ObservationStarted", "ObservationCompleted", "ContextBuilt", "TurnCompleted"],
        "forbidden_gui_event_types": ["ActionStarted", "ActionCompleted"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.llm_tool_loop", "equals": false },
          { "path": "gui_cognition.perception.focus_confidence", "exists": true },
          { "path": "gui_cognition.perception.executable_control_count", "exists": true },
          { "path": "gui_cognition.perception.visual_control_count", "exists": true },
          { "path": "gui_cognition.perception.accessibility_overall_confidence", "exists": true },
          { "path": "gui_cognition.perception.ocr_fast_path", "exists": true },
          { "path": "gui_cognition.context.focus.confidence", "exists": true },
          { "path": "gui_cognition.context.accessibility_health.confidence", "exists": true },
          { "path": "gui_cognition.context.visual_controls.detected", "exists": true },
          { "path": "gui_cognition.context.ocr_performance.fast_path", "exists": true }
        ],
        "forbidden_json_paths": [
          "gui_cognition.perception.screenshot",
          "gui_cognition.perception.screenshot_path",
          "gui_cognition.perception.ocr_blocks.0.text",
          "gui_cognition.perception.raw_accessibility_tree"
        ],
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "text_field_and_button"
        }
      }
    }
  ]
}
