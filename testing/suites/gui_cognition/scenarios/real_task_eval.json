{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "step12.eval.open_chrome",
      "title": "Real task: Open Chrome executes and verifies",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "step12_real_task_eval", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": { "mode_id": "gui_cognition", "label": "GUI Cognition", "app_lock": "gui_cognition", "tool_lock": null, "strategy": "routed_within_lock" },
        "gui_cognition_test": { "disable_live_llm_planner": true, "perception_fixture": "chrome_cdp_focus_search_box", "action_backend_fixture": "services_healthy", "execution_mode": "execute_fixture" },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Open Chrome",
        "expected_status_any": ["completed"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["GoalContractCreated", "ActionStarted", "ActionCompleted", "ExecutionVerificationCompleted", "TurnCompleted"],
        "forbidden_gui_event_types": ["ActionFailed", "ExecutionBlocked"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.execution.action_type", "equals": "OpenApp" },
          { "path": "gui_cognition.execution.status", "equals": "completed" },
          { "path": "gui_cognition.verification.status", "equals": "verified" }
        ],
        "forbidden_json_paths": ["gui_cognition.raw_prompt", "gui_cognition.perception.screenshot"]
      }
    },
