{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "gui_cognition.llm_planner.valid_plan",
      "title": "GUI Cognition LLM planner accepts valid schema-bound plan",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "llm_planner", "step3_planner", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "gui_cognition_test": {
          "llm_planner_fixture": "valid_plan",
          "disable_live_llm_planner": true
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Observe my current screen and create an LLM-assisted GUI plan.",
        "expected_status_any": ["ok"],
        "expected_reply_not_contains_any": ["LLM error", "tool-calling", "raw provider response", "screenshot_path"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["RouteConfirmed", "ContextBuilt", "GoalContractCreated", "LlmPlanningStarted", "LlmPlanningCompleted", "PlanCreated", "PlanValidationCompleted", "TurnCompleted"],
        "forbidden_gui_event_types": ["ActionStarted", "ActionCompleted"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.llm_tool_loop", "equals": false },
          { "path": "gui_cognition.planner.mode", "equals": "llm_schema" },
          { "path": "gui_cognition.planner.llm_attempted", "equals": true },
          { "path": "gui_cognition.planner.llm_status", "equals": "completed" },
          { "path": "gui_cognition.planner.validation_status", "equals": "valid" },
          { "path": "gui_cognition.plan.step_count", "exists": true },
          { "path": "gui_cognition.plan.typed_steps.0.allowed_to_execute", "equals": false },
          { "path": "gui_cognition.plan.typed_steps.0.verification_strategy", "exists": true }
        ]
      }
    },
