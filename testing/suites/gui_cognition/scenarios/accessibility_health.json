{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "gui_cognition.accessibility.fixture_health_score",
      "title": "Accessibility health monitor reports status, confidence, and app scores",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "accessibility_health", "perception"],
      "required_services": ["kria_api"],
      "timeout_seconds": 90,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Report accessibility health for the current screen.",
        "expected_status_any": ["ok"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["ObservationCompleted", "ContextBuilt", "TurnCompleted"],
        "forbidden_gui_event_types": ["ActionStarted", "ActionCompleted"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.perception.accessibility_overall_status", "equals": "healthy" },
          { "path": "gui_cognition.perception.accessibility_overall_confidence", "exists": true },
          { "path": "gui_cognition.perception.accessibility_app_scores.0.score", "exists": true },
          { "path": "gui_cognition.perception.accessibility_stale_node_count", "exists": true },
          { "path": "gui_cognition.perception.accessibility_timeout_count", "exists": true },
          { "path": "gui_cognition.context.accessibility_health.status", "exists": true }
        ],
        "forbidden_json_paths": [
          "gui_cognition.perception.raw_accessibility_tree",
          "gui_cognition.perception.screenshot_path"
        ],
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "text_field_and_button"
        }
      }
    }
  ]
}
