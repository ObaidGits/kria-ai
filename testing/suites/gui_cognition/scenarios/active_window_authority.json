{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "gui_cognition.active_window.gnome_bridge_reliable",
      "title": "GUI Cognition active window uses KRIA GNOME bridge as reliable authority",
      "driver": "desktop_chat_command",
      "tags": ["live", "gui_cognition", "desktop_command", "active_window", "perception", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 60,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "What is on my screen? Report active window.",
        "expected_status_any": ["ok"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["RouteConfirmed", "ObservationStarted", "ObservationCompleted", "ContextBuilt", "TurnCompleted"],
        "forbidden_gui_event_types": ["ActionStarted", "ActionCompleted"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.llm_tool_loop", "equals": false },
          { "path": "gui_cognition.perception.active_window", "equals": "Visual Studio Code - KRIA" },
          { "path": "gui_cognition.perception.active_window_source", "equals": "kria_gnome_shell_bridge" },
          { "path": "gui_cognition.perception.active_window_authority_source", "equals": "kria_gnome_shell_bridge" },
          { "path": "gui_cognition.perception.active_window_authority_status", "equals": "available" },
          { "path": "gui_cognition.perception.active_window_authority_confidence", "equals": 0.98 },
          { "path": "gui_cognition.perception.active_window_reliability", "equals": "reliable" },
          { "path": "gui_cognition.perception.gnome_bridge_status", "equals": "available" },
          { "path": "gui_cognition.perception.active_window_pid", "equals": 4242 },
          { "path": "gui_cognition.perception.active_window_fallback_chain.0.source", "equals": "kria_gnome_shell_bridge" },
          { "path": "gui_cognition.perception.active_window_fallback_chain.0.status", "equals": "matched" }
        ],
        "forbidden_json_paths": [
          "gui_cognition.perception.ocr_blocks.0.text",
          "gui_cognition.perception.screenshot_path",
          "gui_cognition.perception.screenshot"
        ],
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "gnome_bridge_reliable"
        }
      }
    },
