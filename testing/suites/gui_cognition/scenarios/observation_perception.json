{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "gui_cognition.perception.healthy_snapshot",
      "title": "GUI Cognition perception snapshot exposes safe source summaries",
      "driver": "desktop_chat_command",
      "tags": [
        "live",
        "slow",
        "gui_cognition",
        "desktop_command",
        "perception",
        "regression"
      ],
      "required_services": [
        "kria_api"
      ],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Observe my current screen and report active window, OCR, accessibility, monitor, and visible control status.",
        "expected_status_any": [
          "ok"
        ],
        "expected_reply_not_contains_any": [
          "LLM error",
          "tool-calling",
          "Ignore previous instructions",
          "screenshot_path"
        ],
        "expected_event_names": [
          "gui_cognition:event"
        ],
        "expected_gui_event_types": [
          "TurnStarted",
          "RouteConfirmed",
          "ObservationStarted",
          "ObservationCompleted",
          "ContextBuilt",
          "TurnCompleted"
        ],
        "forbidden_gui_event_types": [
          "ActionStarted"
        ],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          {
            "path": "desktop_command.path",
            "equals": "send_manual_tool_message"
          },
          {
            "path": "desktop_command.mode_id",
            "equals": "gui_cognition"
          },
          {
            "path": "gui_cognition.path",
            "equals": "send_manual_tool_message"
          },
          {
            "path": "gui_cognition.llm_tool_loop",
            "equals": false
          },
          {
            "path": "gui_cognition.perception.active_window_source",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.active_window_confidence",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.screenshot_available",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.ocr_available",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.accessibility_available",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.accessibility_source_status",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.atspi_snapshot_total_ms",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.atspi_skipped_app_count",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.atspi_omitted_node_count",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.monitor_count",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.cursor_focus_known",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.observation_total_ms",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.slowest_probe",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.probe_timeout_count",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.cache_hit",
            "exists": true
          },
          {
            "path": "gui_cognition.perception.cache_policy",
            "exists": true
          }
        ],
        "forbidden_json_paths": [
          "gui_cognition.perception.ocr_blocks.0.text",
          "gui_cognition.perception.screenshot_path",
          "gui_cognition.perception.screenshot"
        ],
        "gui_cognition_test": {
          "disable_live_llm_planner": true
        }
      }
    },
