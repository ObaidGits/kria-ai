{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "step9.recovery.focus_lost_refocuses_same_target_fixture",
      "title": "Step 9 recovers a focus_lost failure with one safe RefocusSameTarget",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "step9_recovery", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "step9_focus_recovers",
          "action_backend_fixture": "services_healthy",
          "execution_mode": "execute_fixture"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Focus the visible search field and verify it is focused",
        "expected_status_any": ["recovered"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["TargetResolutionCompleted", "SafetyGateCompleted", "ActionStarted", "ActionCompleted", "ExecutionVerificationCompleted", "RecoveryAssessmentCompleted", "RecoveryActionStarted", "RecoveryActionCompleted", "TurnCompleted"],
        "forbidden_gui_event_types": ["RecoveryBlocked", "ExecutionBlocked"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.recovery_assessment.failure_kind", "equals": "focus_lost" },
          { "path": "gui_cognition.recovery_assessment.recovery_action_kind", "equals": "RefocusSameTarget" },
          { "path": "gui_cognition.recovery_assessment.can_execute_recovery", "equals": true },
          { "path": "gui_cognition.recovery.status", "equals": "recovered" },
          { "path": "gui_cognition.recovery.can_continue_workflow", "equals": false },
          { "path": "gui_cognition.recovery.next_recommended_state", "equals": "retry_original_action" }
        ],
        "forbidden_json_paths": [
          "gui_cognition.raw_prompt",
          "gui_cognition.perception.ocr_blocks.0.text",
          "gui_cognition.perception.screenshot"
        ]
      }
    },
    {
      "id": "step9.recovery.non_idempotent_click_blocks",
      "title": "Step 9 blocks recovery for a non-idempotent click that did not change the screen",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "step9_recovery", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "step8_click_no_change",
          "action_backend_fixture": "services_healthy",
          "execution_mode": "execute_fixture"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Click the Search button",
        "expected_status_any": ["verification_failed"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["ActionStarted", "ActionCompleted", "ExecutionVerificationCompleted", "RecoveryAssessmentCompleted", "RecoveryBlocked", "TurnCompleted"],
        "forbidden_gui_event_types": ["RecoveryActionStarted", "ExecutionBlocked"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "gui_cognition.verification.status", "equals": "verification_failed" },
          { "path": "gui_cognition.recovery_assessment.failure_kind", "equals": "verification_failed" },
          { "path": "gui_cognition.recovery_assessment.can_execute_recovery", "equals": false },
          { "path": "gui_cognition.recovery_assessment.recovery_action_kind", "equals": "Stop" }
        ],
        "forbidden_json_paths": [
          "gui_cognition.raw_prompt",
          "gui_cognition.perception.screenshot"
        ]
      }
    },
    {
