{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "step4.validate.browser_search_valid",
      "title": "Step 4 validates browser search plan for target resolution only",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "step4_validator", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "text_field_and_button",
          "action_backend_fixture": "global_halt"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Open Chrome and search for weather",
        "expected_status_any": ["ok", "blocked"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["ObservationCompleted", "ContextBuilt", "GoalContractCreated", "PlanCreated", "PlanValidationCompleted", "TurnCompleted"],
        "forbidden_gui_event_types": ["ActionStarted", "ActionCompleted"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.plan_validation.readiness_status", "equals": "valid_for_resolution" },
          { "path": "gui_cognition.plan_validation.can_proceed_to_target_resolution", "equals": true },
          { "path": "gui_cognition.plan_validation.can_execute", "equals": false },
          { "path": "gui_cognition.plan_validation.step_results.0.status", "exists": true }
        ]
      }
    },
    {
