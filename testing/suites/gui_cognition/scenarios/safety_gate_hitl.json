{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "step6.hitl.send_email_requires_approval",
      "title": "Step 6 opens HITL metadata for a send email prompt",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "step6_safety_hitl", "hitl", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "text_field_and_button",
          "action_backend_fixture": "global_halt"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Send this email",
        "expected_status_any": ["needs_approval"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["ObservationCompleted", "ContextBuilt", "GoalContractCreated", "PlanCreated", "PlanValidationCompleted", "TargetResolutionCompleted", "SafetyGateStarted", "SafetyGateCompleted", "HitlRequired", "TurnCompleted"],
        "forbidden_gui_event_types": ["ActionStarted", "ActionCompleted", "ExecutionStarted"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.safety_gate.safety_status", "equals": "approval_required" },
          { "path": "gui_cognition.safety_gate.requires_user_approval", "equals": true },
          { "path": "gui_cognition.safety_gate.can_execute", "equals": false },
          { "path": "gui_cognition.safety_gate.can_authorize_step7", "equals": false },
          { "path": "gui_cognition.safety_gate.proposal.proposal_hash", "exists": true },
          { "path": "gui_cognition.safety_gate.proposal.target_hash", "exists": true }
        ],
        "forbidden_json_paths": [
          "gui_cognition.perception.ocr_blocks.0.text",
          "gui_cognition.perception.screenshot",
          "gui_cognition.safety_gate.raw_prompt"
        ]
      }
    },
    {
      "id": "step6.hitl.safe_focus_no_hitl",
      "title": "Step 6 allows a low-risk focus proposal for Step 7 without HITL",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "step6_safety_hitl", "regression"],
      "required_services": ["kria_api"],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "focused_search_field",
          "action_backend_fixture": "global_halt"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Focus the search box",
        "expected_status_any": ["ok"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["TargetResolutionCompleted", "SafetyGateCompleted", "TurnCompleted"],
        "forbidden_gui_event_types": ["HitlRequired", "ActionStarted", "ActionCompleted"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "gui_cognition.safety_gate.safety_status", "equals": "safe_no_approval_required" },
          { "path": "gui_cognition.safety_gate.can_authorize_step7", "equals": true },
          { "path": "gui_cognition.safety_gate.can_execute", "equals": false }
        ]
      }
    },
