{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "gui_cognition.goal.observe_contract",
      "title": "GUI Cognition goal contract extracts observe intent",
      "driver": "desktop_chat_command",
      "tags": [
        "live",
        "slow",
        "gui_cognition",
        "desktop_command",
        "goal_intent",
        "goal_contract",
        "regression"
      ],
      "required_services": [
        "kria_api"
      ],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Observe the current screen and tell me the active window.",
        "expected_status_any": [
          "ok"
        ],
        "expected_reply_not_contains_any": [
          "LLM error",
          "tool-calling",
          "screenshot_path",
          "Ignore previous instructions"
        ],
        "expected_event_names": [
          "gui_cognition:event"
        ],
        "expected_gui_event_types": [
          "ContextBuilt",
          "GoalContractCreated",
          "PlanCreated",
          "TurnCompleted"
        ],
        "forbidden_gui_event_types": [
          "ActionStarted"
        ],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          {
            "path": "desktop_command.path",
            "equals": "send_manual_tool_message"
          },
          {
            "path": "gui_cognition.goal_contract.action_type",
            "equals": "observe"
          },
          {
            "path": "gui_cognition.goal_contract.intent_kind",
            "equals": "observe"
          },
          {
            "path": "gui_cognition.goal_contract.extractor_mode",
            "equals": "deterministic"
          }
        ],
        "gui_cognition_test": {
          "disable_live_llm_planner": true
        }
      }
    },
