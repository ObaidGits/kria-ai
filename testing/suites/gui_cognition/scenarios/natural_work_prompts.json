          "VerificationCompleted",
          "RecoveryProposed",
          "ActionStarted",
          "ActionCompleted"
        ],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          {
            "path": "gui_cognition.goal_contract.intent_kind",
            "equals": "type_text"
          },
          {
            "path": "gui_cognition.goal_contract.action_type",
            "equals": "type_text"
          },
          {
            "path": "gui_cognition.action_backend.global_halt_engaged",
            "equals": true
          },
          {
            "path": "gui_cognition.target_resolution.status",
            "equals": "resolved"
          },
          {
            "path": "gui_cognition.target_resolution.can_execute",
            "equals": false
