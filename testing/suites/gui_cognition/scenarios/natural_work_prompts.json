{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "gui_cognition.natural.observe_work_context",
      "title": "GUI Cognition handles a natural work-context observation prompt",
      "driver": "desktop_chat_command",
      "tags": [
        "live",
        "slow",
        "gui_cognition",
        "desktop_command",
        "prompt_e2e",
        "regression"
      ],
      "required_services": [
        "kria_api"
      ],
      "timeout_seconds": 60,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Before I continue working, check the current desktop and tell me which app or window is active and whether OCR/accessibility are usable.",
        "expected_status_any": [
          "ok"
        ],
        "expected_reply_not_contains_any": [
          "LLM error",
          "tool-calling",
          "screenshot_path",
          "Ignore previous instructions"
        ],
        "expected_event_names": [
          "gui_cognition:event"
        ],
        "expected_gui_event_types": [
          "ObservationCompleted",
          "ContextBuilt",
          "GoalContractCreated",
          "PlanCreated",
          "PlanValidationCompleted",
          "TurnCompleted"
        ],
        "forbidden_gui_event_types": [
          "ActionStarted"
        ],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          {
            "path": "desktop_command.path",
            "equals": "send_manual_tool_message"
          },
          {
            "path": "gui_cognition.path",
            "equals": "send_manual_tool_message"
          },
          {
            "path": "gui_cognition.llm_tool_loop",
            "equals": false
          },
          {
            "path": "gui_cognition.goal_contract.intent_kind",
            "equals": "observe"
          },
          {
            "path": "gui_cognition.goal_contract.action_type",
            "equals": "observe"
          }
        ],
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "text_field_and_button"
        }
      }
    },
