{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "gui_cognition.context.healthy_context_ready",
      "title": "GUI Cognition context builder emits safe typed context summary",
      "driver": "desktop_chat_command",
      "tags": [
        "live",
        "slow",
        "gui_cognition",
        "desktop_command",
        "context_builder",
        "regression"
      ],
      "required_services": [
        "kria_api"
      ],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Observe my current screen and report the GUI context quality.",
        "expected_status_any": [
          "ok"
        ],
        "expected_reply_not_contains_any": [
          "LLM error",
          "tool-calling",
          "screenshot_path",
          "Ignore previous instructions"
        ],
        "expected_event_names": [
          "gui_cognition:event"
        ],
        "expected_gui_event_types": [
          "ObservationCompleted",
          "ContextBuilt",
          "GoalContractCreated",
          "TurnCompleted"
        ],
        "forbidden_gui_event_types": [
          "ActionStarted"
        ],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          {
            "path": "desktop_command.path",
            "equals": "send_manual_tool_message"
          },
          {
            "path": "gui_cognition.context.context_id",
            "exists": true
          },
          {
            "path": "gui_cognition.context.observation_id",
            "exists": true
          },
          {
            "path": "gui_cognition.context.trusted_control_count",
            "exists": true
          },
          {
            "path": "gui_cognition.context.executable_control_count",
            "exists": true
          },
          {
            "path": "gui_cognition.context.freshness",
            "exists": true
          }
        ],
        "gui_cognition_test": {
          "disable_live_llm_planner": true
        }
      }
    },
