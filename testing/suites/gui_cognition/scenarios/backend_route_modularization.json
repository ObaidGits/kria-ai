{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "gui_cognition.backend.observe_route",
      "title": "GUI Cognition backend route observes through manual selected mode",
      "driver": "desktop_chat_command",
      "tags": [
        "live",
        "slow",
        "gui_cognition",
        "desktop_command",
        "backend_route",
        "routing",
        "regression"
      ],
      "required_services": [
        "kria_api"
      ],
      "timeout_seconds": 120,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "Observe my current screen.",
        "expected_status_any": [
          "ok"
        ],
        "expected_reply_not_contains_any": [
          "LLM error",
          "tool-calling"
        ],
        "expected_event_names": [
          "gui_cognition:event"
        ],
        "expected_gui_event_types": [
          "TurnStarted",
          "RouteConfirmed",
          "ObservationStarted",
          "ObservationCompleted",
          "ContextBuilt",
          "GoalContractCreated",
          "PlanCreated",
          "TurnCompleted"
        ],
        "forbidden_gui_event_types": [
          "ActionStarted"
        ],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          {
            "path": "desktop_command.path",
            "equals": "send_manual_tool_message"
          },
          {
            "path": "desktop_command.mode_id",
            "equals": "gui_cognition"
          },
          {
            "path": "gui_cognition.path",
            "equals": "send_manual_tool_message"
          },
          {
            "path": "gui_cognition.llm_tool_loop",
            "equals": false
          }
        ],
        "gui_cognition_test": {
          "disable_live_llm_planner": true
        }
      }
    },
