{
  "schema_version": "kria.testing.scenarios.v1",
  "scenarios": [
    {
      "id": "gui_cognition.visual.fixture_buttons_supporting_evidence",
      "title": "Visual control detector contributes supporting button evidence",
      "driver": "desktop_chat_command",
      "tags": ["live", "slow", "gui_cognition", "desktop_command", "visual_controls", "perception"],
      "required_services": ["kria_api"],
      "timeout_seconds": 90,
      "inputs": {
        "manual_profile": {
          "mode_id": "gui_cognition",
          "label": "GUI Cognition",
          "app_lock": "gui_cognition",
          "tool_lock": null,
          "strategy": "routed_within_lock"
        },
        "expected_desktop_path": "send_manual_tool_message",
        "prompt": "What buttons or visual controls are on my screen?",
        "expected_status_any": ["ok"],
        "expected_event_names": ["gui_cognition:event"],
        "expected_gui_event_types": ["ObservationCompleted", "ContextBuilt", "TurnCompleted"],
        "forbidden_gui_event_types": ["ActionStarted", "ActionCompleted"],
        "assert_gui_event_sequence_monotonic": true,
        "expected_json_paths": [
          { "path": "desktop_command.path", "equals": "send_manual_tool_message" },
          { "path": "gui_cognition.perception.visual_control_count", "exists": true },
          { "path": "gui_cognition.perception.visual_control_summary.detected", "exists": true },
          { "path": "gui_cognition.perception.visual_control_summary.button_like", "exists": true },
          { "path": "gui_cognition.perception.visual_control_summary.false_positive_risk", "equals": "supporting_visual_only" }
        ],
        "forbidden_json_paths": [
          "gui_cognition.perception.screenshot",
          "gui_cognition.perception.ocr_blocks.0.text"
        ],
        "gui_cognition_test": {
          "disable_live_llm_planner": true,
          "perception_fixture": "text_field_and_button"
        }
      }
    }
  ]
}
