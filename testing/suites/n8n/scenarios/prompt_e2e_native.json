    {
      "id": "n8n.prompt_e2e.native.drift_blocks_run",
      "title": "Native Chat API E2E: drifted workflow blocks run",
      "driver": "chat_api",
      "tags": [
        "live",
        "slow",
        "n8n",
        "api",
        "prompt_e2e",
        "regression"
      ],
      "required_services": [
        "kria_api",
        "n8n"
      ],
      "timeout_seconds": 420,
      "inputs": {
        "steps": [
          {
            "prompt": "Create an n8n workflow named KRIA E2E Test Drift Source ${run_id} that receives a movie title and fetches movie details using HTTP",
            "expected_status_any": [
              "draft_created",
              "validated"
            ],
            "expected_n8n_action": "create_authoring_draft",
            "fail_on_generic_create_refusal": true,
            "extract": {
              "workflow_id": [
                "n8n.result.workflow.workflow_id",
                "n8n.result.workflow_id"
              ],
              "n8n_workflow_id": [
                "n8n.result.workflow.n8n_workflow_id",
                "n8n.result.n8n_workflow_id"
              ]
            },
            "n8n_verifications": [
              {
                "kind": "workflow_inactive",
                "var": "n8n_workflow_id"
              }
            ]
          },
          {
            "prompt": "Approve draft ${workflow_id}",
            "expected_status_any": [
              "approved"
            ],
            "expected_n8n_action": "approve_authoring_draft",
            "n8n_verifications": [
              {
                "kind": "workflow_active",
                "var": "n8n_workflow_id"
              }
            ]
          },
          {
            "n8n_actions": [
              {
                "kind": "store_workflow_hash",
                "var": "n8n_workflow_id",
                "output_var": "original_hash"
              },
              {
                "kind": "mutate_workflow_name",
                "var": "n8n_workflow_id",
                "suffix": " Drifted ${run_id}",
                "hash_var": "drifted_hash"
              }
            ],
            "prompt": "Confirm workflow ${workflow_id}",
            "expected_http_status_any": [
              502
            ],
            "expected_reply_contains_any": [
              "changed",
              "review",
              "drift",
              "refresh"
            ],
            "n8n_verifications": [
              {
                "kind": "workflow_still_exists",
                "var": "n8n_workflow_id"
              }
            ]
          }
        ],
        "cleanup": {
          "cleanup_kria_draft_workflow_ids": true,
          "workflow_id_vars": [
            "workflow_id"
          ]
        }
      }
    }
  ]
}
