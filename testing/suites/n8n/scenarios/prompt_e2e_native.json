    {
      "id": "n8n.prompt_e2e.native.unsupported_destructive_request",
      "title": "Native Chat API E2E: unsupported destructive request is blocked",
      "driver": "chat_api",
      "tags": [
        "live",
        "slow",
        "n8n",
        "api",
        "prompt_e2e",
        "regression"
      ],
      "required_services": [
        "kria_api"
      ],
      "timeout_seconds": 180,
