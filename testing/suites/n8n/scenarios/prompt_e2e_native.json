    {
      "id": "n8n.prompt_e2e.native.update_creates_copy",
      "title": "Native Chat API E2E: update creates draft copy",
      "driver": "chat_api",
      "tags": [
        "live",
        "slow",
        "n8n",
        "api",
        "prompt_e2e",
        "regression",
        "authoring"
      ],
      "required_services": [
        "kria_api",
        "n8n"
      ],
      "timeout_seconds": 300,
      "inputs": {
        "steps": [
          {
            "prompt": "Create an n8n workflow named KRIA E2E Test Update Source ${run_id} that receives a movie title and fetches movie details using HTTP",
            "expected_status_any": [
              "draft_created",
              "validated"
            ],
            "expected_n8n_action": "create_authoring_draft",
            "extract": {
              "workflow_id": [
                "n8n.result.workflow.workflow_id",
                "n8n.result.workflow_id"
              ],
              "n8n_workflow_id": [
                "n8n.result.workflow.n8n_workflow_id",
                "n8n.result.n8n_workflow_id"
              ]
            }
          },
          {
            "prompt": "Update ${workflow_id} so it accepts title from prompt",
            "expected_status_any": [
              "updated_copy_created",
              "draft_created"
            ],
            "expected_n8n_action": "create_updated_copy",
            "extract": {
              "copy_workflow_id": [
                "n8n.result.workflow.workflow_id",
                "n8n.result.workflow_id"
              ],
              "copy_n8n_workflow_id": [
                "n8n.result.workflow.n8n_workflow_id",
                "n8n.result.n8n_workflow_id"
              ]
            },
            "n8n_verifications": [
              {
                "kind": "workflow_still_exists",
                "var": "n8n_workflow_id"
              },
              {
                "kind": "workflow_inactive",
                "var": "copy_n8n_workflow_id"
              }
            ]
          }
        ],
        "cleanup": {
          "cleanup_kria_draft_workflow_ids": true,
          "workflow_id_vars": [
            "copy_workflow_id",
            "workflow_id"
          ]
        }
      }
    },
