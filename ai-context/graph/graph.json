{
  "nodes": [
    {
      "id": "system.kria",
      "type": "system",
      "description": "Local-first desktop AI assistant with chat, voice, tools, memory, and OS integrations.",
      "importance": "high"
    },
    {
      "id": "module.desktop_runtime",
      "type": "module",
      "description": "Primary Tauri runtime host that wires core services and UI events.",
      "importance": "high"
    },
    {
      "id": "module.kria_core",
      "type": "module",
      "description": "Main Rust library containing agent, tools, safety, LLM, memory, routing, sidecar, MCP, image, and voice logic.",
      "importance": "high"
    },
    {
      "id": "module.ui",
      "type": "module",
      "description": "SolidJS frontend using Tauri invokes and event listeners.",
      "importance": "high"
    },
    {
      "id": "module.server",
      "type": "module",
      "description": "Secondary Axum API/WebSocket surface; chat route is currently a stub.",
      "importance": "medium"
    },
    {
      "id": "module.python_sidecar",
      "type": "module",
      "description": "Python JSON-RPC processor process for image, document, code, web, audio, embeddings, news, and Google helpers.",
      "importance": "high"
    },
    {
      "id": "module.agent",
      "type": "module",
      "description": "User-turn orchestration, routing, streaming, parsing, tool execution, and cancellation.",
      "importance": "high"
    },
    {
      "id": "module.routing",
      "type": "module",
      "description": "Semantic and lexical router that narrows domains and tool schemas per turn.",
      "importance": "high"
    },
    {
      "id": "module.tools",
      "type": "module",
      "description": "Tool definitions, handlers, registry, sidecar tools, image tools, Google Workspace tools, and MCP-backed tools.",
      "importance": "high"
    },
    {
      "id": "module.safety",
      "type": "module",
      "description": "Risk policy, HITL approval, audit logging, rollback snapshots, blacklist, and PIN guard.",
      "importance": "high"
    },
    {
      "id": "module.llm",
      "type": "module",
      "description": "Model router, local/cloud backend abstraction, token/context helpers, and local orchestration.",
      "importance": "high"
    },
    {
      "id": "module.llm_orchestrator",
      "type": "module",
      "description": "Hardware-aware llama-server lifecycle, telemetry, watchdog, thresholds, vision strategy, and VRAM budgeting.",
      "importance": "high"
    },
    {
      "id": "module.memory",
      "type": "module",
      "description": "SQLite conversations, preferences, media, facts, documents, RAG, embeddings, and vector index.",
      "importance": "high"
    },
    {
      "id": "module.voice",
      "type": "module",
      "description": "Legacy voice pipeline plus v2 streaming voice architecture.",
      "importance": "medium"
    },
    {
      "id": "module.image",
