{
  "enable_auto_update": true,
  "fast_mode": true,
  "watched_paths": [
    "Cargo.toml",
    "crates/kria-core/src",
    "crates/kria-desktop/src",
    "crates/kria-server/src",
    "crates/kria-eval/src",
    "crates/kria-connection-control/src",
    "kria-modules/src",
    "ui/src",
    "config"
  ],
  "ignore_paths": [
    ".git",
    ".pytest_cache",
    ".ruff_cache",
    "__pycache__",
    "ai-context",
    "models",
    "target",
    "tests/e2e/playwright-report",
    "tests/e2e/test-results",
    "ui/dist",
    "ui/node_modules"
  ]
}
