{
  "servers": [
    {
      "name": "fs",
      "transport": "stdio",
      "command": "mcp-server-filesystem",
      "args": ["/home", "/media", "/tmp"],
      "enabled": true,
      "trust_level": "YELLOW",
      "tool_overrides": {
        "move_file": "RED",
        "write_file": "YELLOW",
        "edit_file": "YELLOW"
      }
    },
    {
      "name": "gworkspace",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "google-workspace-mcp", "serve"],
      "env": {
        "GOOGLE_MCP_CONFIG_DIR": "/home/obaid/.google-mcp"
      },
      "enabled": true,
      "trust_level": "YELLOW",
      "tool_overrides": {
        "createGmailDraft": "YELLOW",
        "sendGmailDraft": "YELLOW",
        "deleteGmailMessage": "RED",
        "deleteFile": "RED",
        "createCalendarEvent": "YELLOW",
        "deleteCalendarEvent": "RED"
      }
    },
    {
      "name": "github",
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "enabled": true,
      "trust_level": "YELLOW",
      "tool_overrides": {
        "create_issue": "YELLOW",
        "create_pull_request": "YELLOW",
        "add_issue_comment": "YELLOW",
        "create_or_update_file": "YELLOW",
        "update_pull_request": "YELLOW",
        "merge_pull_request": "RED",
        "delete_file": "RED"
      }
    },
    {
      "name": "colab-mcp",
      "transport": "stdio",
      "command": "uvx",
      "args": ["--python", "/home/obaid/anaconda3/bin/python3.13", "--from", "git+https://github.com/googlecolab/colab-mcp", "colab-mcp"],
      "enabled": true,
      "trust_level": "YELLOW",
      "tool_overrides": {}
    }
  ]
}
