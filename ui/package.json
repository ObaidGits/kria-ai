{
  "name": "kria-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run assets:build && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "e2e:flows": "playwright test e2e/smoke.spec.ts e2e/flow-map.spec.ts",
    "e2e:a11y": "playwright test e2e/accessibility.spec.ts",
    "e2e:performance": "playwright test e2e/performance.spec.ts",
    "e2e:report": "playwright show-report",
    "story:dev": "storybook dev -p 6006 --no-open",
    "story:build": "storybook build",
    "tokens:build": "node tokens/build.mjs",
    "fonts:build": "node scripts/build-fonts.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "assets:build": "npm run tokens:build && npm run fonts:build && npm run icons:build",
    "lint:tokens": "node scripts/token-lint.mjs",
    "lint:components": "node scripts/component-concept-audit.mjs",
    "lint:expansion": "node scripts/expansion-governance-lint.mjs",
    "lint:guardrails": "node scripts/guardrail-lint.mjs",
    "test:expansion-lint": "node --test scripts/expansion-governance-lint.test.mjs",
    "lint:ui-consistency": "npm run lint:tokens && npm run lint:components && npm run lint:expansion && npm run lint:guardrails",
    "quality:final": "npm run check && npm run lint:ui-consistency && npm run test:run && npm run build && npm run e2e",
    "quality:evidence": "npm run lint:ui-consistency; npm run test:run; npm run build; npm run e2e"
  },
  "dependencies": {
    "@kobalte/core": "0.13.12",
    "@tanstack/solid-virtual": "3.13.33",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.0",
    "ngraph.forcelayout": "3.3.1",
    "ngraph.graph": "20.0.1",
    "solid-js": "^1.9.0",
    "three": "0.169.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@fontsource/ibm-plex-sans": "5.2.6",
    "@fontsource/jetbrains-mono": "5.2.6",
    "@fontsource/space-grotesk": "5.2.10",
    "@playwright/test": "1.61.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/dompurify": "^3.0.5",
    "@types/three": "0.169.0",
    "fast-check": "3.23.2",
    "jsdom": "^25.0.1",
    "lucide-static": "0.544.0",
    "storybook": "10.5.0",
    "storybook-solidjs-vite": "10.6.0",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^2.1.8"
  }
}
