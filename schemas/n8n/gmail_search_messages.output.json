{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gmail Search Messages Output",
  "type": "object",
  "required": ["result", "matches"],
  "properties": {
    "result": { "type": "string" },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message_ref", "summary"],
        "properties": {
          "message_ref": { "type": "string" },
          "summary": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
